# Copy to `.env` (or `.env.local`) to override. All values are build-time (Vite).

# Base URL of the translator-qa live test runner that powers the "Live QA Lab".
# Local dev default is http://localhost:8787. In production point this at your
# deployed runner, e.g. https://qa.memdecks.com
VITE_RUNNER_URL=http://localhost:8787
